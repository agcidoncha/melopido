{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/ColorSwatch/**",
              "components/commerce/FeatureIcon/**",
              "components/commerce/SizeCard/**",
              "components/content/CareCard/**",
              "components/content/ContentCard/**",
              "components/core/Button/**",
              "components/layout/FooterDesktop/**",
              "components/layout/Header/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Playfair Display|Pontiac))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Playfair Display, Pontiac."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|children|arrow|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, children, arrow, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:round|light|primary|amazon|guide)$/]",
        "message": "<Button> variant must be one of 'round' | 'light' | 'primary' | 'amazon' | 'guide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CareCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|key|ref|className|style|children)$/]",
        "message": "<CareCard> doesn't accept that prop. Declared props: icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorSwatch'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|active|disabled|size|onClick|key|ref|className|style|children)$/]",
        "message": "<ColorSwatch> doesn't accept that prop. Declared props: color, active, disabled, size, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|href|key|ref|className|style|children)$/]",
        "message": "<ContentCard> doesn't accept that prop. Declared props: title, children, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|key|ref|className|style|children)$/]",
        "message": "<FeatureIcon> doesn't accept that prop. Declared props: icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterDesktop'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|key|ref|className|style|children)$/]",
        "message": "<FooterDesktop> doesn't accept that prop. Declared props: logo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|claim|claimSub|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: logo, claim, claimSub."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|dimensions|href|key|ref|className|style|children)$/]",
        "message": "<SizeCard> doesn't accept that prop. Declared props: label, dimensions, href."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "CareCard": {
        "replaces": []
      },
      "ColorSwatch": {
        "replaces": []
